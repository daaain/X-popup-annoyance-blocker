{
  "name": "x-popup-annoyance-blocker",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that dismisses x.com's forced sign-up / install-the-app popups and restores scrolling.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "test": "node test/e2e.mjs",
    "lint": "web-ext lint --source-dir extension",
    "test:synthetic": "node test/synthetic.mjs",
    "test:all": "node test/synthetic.mjs && node test/e2e.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "web-ext": "^10.6.0"
  }
}
